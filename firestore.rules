rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    // Lấy role của user trong family
    function memberDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(myUid())).data;
    }

    function isFamilyMember(familyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(myUid()));
    }

    function isAdminOf(familyId) {
      return isFamilyMember(familyId) &&
        (memberDoc(familyId).role == 'fatherAdmin' || memberDoc(familyId).role == 'admin');
    }

    function isManagerOf(familyId) {
      return isFamilyMember(familyId) &&
        (memberDoc(familyId).role == 'motherManager' || memberDoc(familyId).role == 'manager');
    }

    function isAdminOrManagerOf(familyId) {
      return isAdminOf(familyId) || isManagerOf(familyId);
    }

    function isChildOf(familyId) {
      return isFamilyMember(familyId) &&
        (memberDoc(familyId).role == 'childLimited' || memberDoc(familyId).role == 'child');
    }

    function canBootstrapFamily(familyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(myUid())) &&
        get(/databases/$(database)/documents/users/$(myUid())).data.familyId == familyId;
    }

    function canBootstrapSelfMember(familyId, memberId) {
      return canBootstrapFamily(familyId) &&
        memberId == myUid() &&
        !exists(/databases/$(database)/documents/families/$(familyId)/members/$(myUid())) &&
        request.resource.data.uid == myUid();
    }

    // ──────────── Users ────────────
    match /users/{uid} {
      allow read: if signedIn() && myUid() == uid;
      allow write: if signedIn() && myUid() == uid;
    }

    // ──────────── Family root ────────────
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if canBootstrapFamily(familyId) && request.resource.data.ownerUid == myUid();
      allow update, delete: if isAdminOf(familyId);
    }

    // ──────────── Wallets: chỉ chủ sở hữu ────────────
    match /users/{uid}/wallets/{walletId} {
      allow read, write: if signedIn() && myUid() == uid;
      // Admin/Manager của cùng family được đọc ví thành viên
      allow read: if signedIn() &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        isAdminOrManagerOf(get(/databases/$(database)/documents/users/$(uid)).data.familyId);
    }

    // ──────────── Transactions: chủ sở hữu + admin/manager ────────────
    match /users/{uid}/transactions/{txId} {
      allow read, write: if signedIn() && myUid() == uid;
      // Admin/Manager đọc giao dịch thành viên
      allow read: if signedIn() &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        isAdminOrManagerOf(get(/databases/$(database)/documents/users/$(uid)).data.familyId);
      // Admin xóa bất kỳ; Manager chỉ xóa của mình
      allow delete: if signedIn() && myUid() == uid;
      allow delete: if signedIn() &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        isAdminOf(get(/databases/$(database)/documents/users/$(uid)).data.familyId);
    }

    // ──────────── Family members ────────────
    match /families/{familyId}/members/{memberId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isAdminOf(familyId) || canBootstrapSelfMember(familyId, memberId);
      allow update: if isAdminOf(familyId);
      allow delete: if isAdminOf(familyId);
    }

    // ──────────── [THÊM MỚI] Invite codes: admin tạo/xóa; mọi người kiểm tra ────────────
    match /families/{familyId}/invite_codes/{codeId} {
      allow read: if isAdminOf(familyId);
      allow create: if isAdminOf(familyId);
      allow update: if isAdminOf(familyId);
      allow delete: if isAdminOf(familyId);
      // Mọi người (chưa authenticate) có thể kiểm tra code (được gọi từ register)
      allow read: if signedIn() == false && request.query.where[0].field == 'code';
    }

      // Alias collection theo checklist mới
      match /families/{familyId}/invites/{inviteId} {
        allow read: if isFamilyMember(familyId) || signedIn();
        allow create, update, delete: if isAdminOrManagerOf(familyId);
      }

    // ──────────── Family meta (seed flag) ────────────
    match /families/{familyId}/meta/{docId} {
      allow read, write: if isAdminOf(familyId);
    }

    // ──────────── Debts: admin/manager xem và quản lý; child không xem ────────────
    match /families/{familyId}/debts/{debtId} {
      allow read, write: if isAdminOrManagerOf(familyId);
    }

    // ──────────── Funds: admin/manager quản lý; child chỉ đọc ────────────
    match /families/{familyId}/funds/{fundId} {
      allow read: if isFamilyMember(familyId);
      allow write: if isAdminOrManagerOf(familyId);
    }

    // ──────────── Events: mọi thành viên đọc; admin/manager tạo/sửa/xóa ────────────
    match /families/{familyId}/events/{eventId} {
      allow read: if isFamilyMember(familyId);
      allow create, update, delete: if isAdminOrManagerOf(familyId);
    }

    // ──────────── [THÊM MỚI] Anniversary (Kỷ niệm): mọi thành viên đọc; admin/manager quản lý ────────────
    match /families/{familyId}/anniversaries/{anniversaryId} {
      allow read: if isFamilyMember(familyId);
      allow create, update, delete: if isAdminOrManagerOf(familyId);
    }

    // ──────────── [THÊM MỚI] Photos (Ảnh kỷ niệm): mọi thành viên đọc; admin/manager/uploader quản lý ────────────
    match /families/{familyId}/photos/{photoId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isFamilyMember(familyId);
      allow update, delete: if isAdminOrManagerOf(familyId) || request.resource.data.uploadedBy == myUid();
    }

    // ──────────── [THÊM MỚI] Ví chung gia đình ────────────
    match /families/{familyId}/wallets/{walletId} {
      allow read: if isFamilyMember(familyId);
      allow create, update: if isAdminOrManagerOf(familyId);
      allow delete: if isAdminOf(familyId);
    }

    // ──────────── [THÊM MỚI] Thông báo realtime gia đình ────────────
    match /families/{familyId}/notifications/{notifId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isFamilyMember(familyId);
      allow delete: if isAdminOf(familyId);
    }

    // ──────────── collectionGroup cho invite code lookup ────────────
    match /{path=**}/invites/{inviteId} {
      allow read: if signedIn();
    }

    // ──────────── [XII] Vị trí realtime thành viên gia đình ────────────
    // live_locations/{userId} — chỉ thành viên cùng family mới đọc được
    match /live_locations/{targetUserId} {
      // Chỉ cho phép đọc nếu cùng familyId
      allow read: if signedIn() &&
        exists(/databases/$(database)/documents/live_locations/$(targetUserId)) &&
        isFamilyMember(
          get(/databases/$(database)/documents/live_locations/$(targetUserId)).data.familyId
        );

      // Chỉ được ghi vị trí của chính mình
      allow write: if signedIn() &&
        myUid() == targetUserId &&
        request.resource.data.userId == myUid() &&
        request.resource.data.familyId is string &&
        request.resource.data.familyId.size() > 0 &&
        request.resource.data.latitude is number &&
        request.resource.data.longitude is number;

      // Chỉ được xóa vị trí của chính mình
      allow delete: if signedIn() && myUid() == targetUserId;
    }
  }
}